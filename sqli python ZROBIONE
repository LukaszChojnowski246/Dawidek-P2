import sqlite3
try:
    conn = sqlite3.connect('baza.db')
    cursor = conn.cursor()
    conn.commit()
except sqlite3.Error as c:
    print(f"błąd bazy danych: {c}")
finally:
    if conn:
        conn.close()

cursor.execute('''
    CREATE TABLE IF NOT EXISTS users (
    id_imie INTEGER PRIMARY KEY,
    name TEXT,
    age INTEGER
    )
''')

cursor.execute('''
    INSERT INTO users (name, age) VALUES ('Marcin', 32)
''')
cursor.execute('''
    INSERT INTO users (name, age) VALUES ('Natalia', 15)
''')



cursor.execute("""
    UPDATE users SET age = 13 WHERE name = 'Marcin'
""")


cursor.execute("""
    DELETE FROM users WHERE name = 'Natalia'
""")


