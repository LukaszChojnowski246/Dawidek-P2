import sqlite3
conn = sqlite3.connect('biblioteka.db')
cursor = conn.cursor()

cursor.execute('''
    CREATE TABLE IF NOT EXISTS ksiegarnia (
        id INTEGER PRIMARY KEY,
        tytul TEXT,
       autor INTEGER
        )
    ''')
def dodanie(): 
        a = input("podaj tutyl ksiazki ")
